#: errors/registry.py:70
msgid "Too many requests. Try again later."
msgstr "طلبات كثيرة جدًا. حاول مرة أخرى لاحقًا."

#: errors/registry.py:77
msgid "The service is temporarily unavailable. Try again."
msgstr "الخدمة غير متاحة مؤقتًا. حاول مرة أخرى."

#: errors/registry.py:80
msgid "An unexpected error occurred."
msgstr "حدث خطأ غير متوقع."
